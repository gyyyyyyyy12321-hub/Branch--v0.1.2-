# Copy to .env to override defaults. Everything is optional.
PORT=3000
# Use :memory: for a throwaway database (handy for tests)
DB_PATH=data/app.db
UPLOAD_DIR=uploads
# Change this to any long random string outside local development
JWT_SECRET=dev-only-secret-change-me
# Reports group by calendar day in this timezone: hours ahead of UTC (8 = Singapore)
REPORT_UTC_OFFSET_HOURS=8
NODE_ENV=development
